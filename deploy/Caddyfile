# Caddyfile for Prein AI - Todo Application
# Caddy automatically obtains and renews TLS certificates via Let's Encrypt

# Basic auth credentials are loaded from environment variables.
# BASIC_AUTH_USER and BASIC_AUTH_HASH must be set in the Caddy systemd
# environment (see deploy/caddy-env.example).
#
# Generate a password hash with: caddy hash-password --plaintext 'yourpassword'

# IP-based (no TLS) - for testing or internal use
:80 {
    basicauth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    reverse_proxy localhost:3002
}

# Production config example with domain (auto-HTTPS via Let's Encrypt):
# yourdomain.com {
#     basicauth {
#         {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
#     }
#
#     reverse_proxy localhost:3002
# }
